---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { Content as NotesIntro, frontmatter } from '../../content/pages/notes-index.md';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Notes | Leonardo Vanni" description={frontmatter.description}>
  <h1 class="font-heading text-3xl font-semibold">{frontmatter.title}</h1>

  {/* Intro sentence, which doubles as the empty state. No dummy posts. */}
  <div class="prose mt-6 text-muted">
    <NotesIntro />
  </div>

  {
    notes.length > 0 && (
      <ul class="mt-10 grid max-w-[68ch] gap-8">
        {notes.map((note) => (
          <li class="border-t border-border pt-6">
            <p class="kicker">
              <time datetime={note.data.date.toISOString().slice(0, 10)}>
                {note.data.date.toISOString().slice(0, 10)}
              </time>
            </p>
            <a
              href={`/notes/${note.id}/`}
              class="mt-1 block font-heading text-lg font-semibold hover:text-accent"
            >
              {note.data.title}
            </a>
            <p class="mt-2 text-sm text-muted">{note.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
