---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { Content as ThesisBody, frontmatter as thesis } from '../content/pages/thesis-page.md';
import calibration from '../assets/thesis/calibration.png';
import ellipsoids from '../assets/thesis/ellipsoids.png';

// BibTeX from the Cite block in src/content/pages/thesis-page.md.
const citation = `@thesis{vanni2026geometric,
  author      = {Vanni, Leonardo},
  title       = {Geometrically-Grounded Uncertainty Quantification
                 for Foundational 3D Vision Models},
  school      = {Bocconi University},
  year        = {2026},
  type        = {BSc thesis},
  note        = {Supervisor: Alessandro Pigati}
}`;

const thesisJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Thesis',
  name: thesis.title,
  author: {
    '@type': 'Person',
    name: 'Leonardo Vanni',
    url: 'https://leonardovanni.com',
  },
  sourceOrganization: {
    '@type': 'CollegeOrUniversity',
    name: thesis.institution,
  },
  datePublished: String(thesis.year),
});
---

<Base title="Thesis | Leonardo Vanni" description={thesis.description}>
  <script type="application/ld+json" is:inline slot="head" set:html={thesisJsonLd} />

  <header class="max-w-[72ch]">
    <p class="kicker">
      {thesis.kind} · {thesis.institution} · {thesis.year} · Supervisor: {thesis.supervisor}
    </p>
    <h1 class="mt-3 font-heading text-3xl font-semibold text-balance">{thesis.title}</h1>
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a
        href={thesis.pdf}
        class="inline-block bg-accent px-5 py-2.5 font-medium text-bg hover:bg-text"
      >
        Download thesis (PDF)
      </a>
      <a
        href={thesis.repo}
        class="font-mono text-[0.8rem] text-muted underline decoration-rule underline-offset-3 hover:text-accent hover:decoration-accent"
        >Code (GitHub)</a
      >
      <a
        href={thesis.release}
        class="font-mono text-[0.8rem] text-muted underline decoration-rule underline-offset-3 hover:text-accent hover:decoration-accent"
        >Release v1.0.0, with trained weights</a
      >
    </div>
  </header>

  <div class="prose mt-10">
    <ThesisBody />
  </div>

  <figure class="mt-10 max-w-[72ch]">
    <Image
      src={calibration}
      alt="Coverage plot: fraction of frames inside each chi-squared region against the nominal level, for the raw and temperature-calibrated model, both close to the diagonal."
      class="border border-border"
    />
    <figcaption class="mt-2 text-sm text-muted">
      Coverage on the evaluation subset: the fraction of frames whose squared Mahalanobis distance
      falls inside each nominal χ²₆ region. The raw and calibrated curves almost coincide, because
      the fitted temperature is T = 1.01: the trained head is already calibrated on typical frames.
    </figcaption>
  </figure>

  <figure class="mt-10 max-w-[72ch]">
    <Image
      src={ellipsoids}
      alt="Two renders of the same scene. Left: camera-centre uncertainty ellipsoids predicted by the model. Right: the analytical ellipsoids from bundle adjustment, drawn at 75 times scale."
      class="border border-border"
    />
    <figcaption class="mt-2 text-sm text-muted">
      Predicted 95% camera-centre ellipsoids (left) against the analytical covariance of bundle
      adjustment for the same scene (right, drawn at ×75). The orientation and the relative sizes
      agree; the magnitudes do not, which is why the comparison is structural.
    </figcaption>
  </figure>

  <section class="mt-12 max-w-[72ch]">
    <h2 class="kicker">Cite</h2>
    <pre
      class="mt-4 overflow-x-auto border border-border bg-surface p-4 font-mono text-[0.8rem] leading-relaxed"><code>{citation}</code></pre>
  </section>
</Base>
