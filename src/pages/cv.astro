---
import Base from '../layouts/Base.astro';
import { Content as CvBody, frontmatter } from '../content/pages/cv-page.md';
import { Content as Teaching } from '../content/pages/teaching.md';
---

<Base title="CV — Leonardo Vanni" description={frontmatter.description}>
  <h1 class="font-heading text-3xl font-semibold">{frontmatter.title}</h1>

  <a
    href={frontmatter.pdf}
    class="mt-6 inline-block bg-accent px-5 py-2.5 font-medium text-bg hover:bg-text"
  >
    Download CV (PDF)
  </a>

  {/* Contact: email / LinkedIn / GitHub only — never a phone number. */}
  <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-1">
    <li>
      <a
        href="mailto:info@leonardovanni.com"
        class="font-mono text-[0.8rem] text-accent underline decoration-accent/40 underline-offset-3 hover:text-text hover:decoration-text"
        >info@leonardovanni.com</a
      >
    </li>
    <li>
      <a
        href="https://www.linkedin.com/in/leonardo-vanni/"
        class="font-mono text-[0.8rem] text-accent underline decoration-accent/40 underline-offset-3 hover:text-text hover:decoration-text"
        >LinkedIn</a
      >
    </li>
    <li>
      <a
        href="https://github.com/VanniLeonardo"
        class="font-mono text-[0.8rem] text-accent underline decoration-accent/40 underline-offset-3 hover:text-text hover:decoration-text"
        >GitHub</a
      >
    </li>
  </ul>

  <div class="prose mt-8">
    <CvBody />
  </div>

  {/* Teaching & leadership live on the CV page — /teaching/ redirects here. */}
  <section class="mt-12 max-w-[68ch] border-t border-border pt-8">
    <h2 class="kicker">Teaching & Leadership</h2>
    <div class="prose mt-2">
      <Teaching />
    </div>
  </section>
</Base>
