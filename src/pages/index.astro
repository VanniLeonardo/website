---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ResearchRow from '../components/ResearchRow.astro';
import NewsItem from '../components/NewsItem.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import { Content as HeroCurrently, frontmatter as hero } from '../content/pages/hero.md';
import { Content as Bio, frontmatter as bio } from '../content/pages/bio.md';
import { frontmatter as background } from '../content/pages/background.md';
import { frontmatter as experience } from '../content/pages/experience.md';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import { byTumStart } from '../lib/dates.ts';

interface HeroLink {
  label: string;
  url: string;
  weight?: 'primary' | 'secondary';
}
const heroLinks: HeroLink[] = hero.links ?? [];

interface BackgroundEntry {
  institution: string;
  qualification: string;
  period: string;
  note: string;
  url?: string;
}
const education: BackgroundEntry[] = background.entries ?? [];

interface ExperienceItem {
  role: string;
  organization: string;
  period: string;
  featured?: boolean;
}
const roles: ExperienceItem[] = (experience.entries ?? []).filter(
  (entry: ExperienceItem) => entry.featured,
);

// Wording that depends on whether the TUM programme has started.
const status = byTumStart(hero.status, hero.statusFrom);
const bioLead = byTumStart(bio.lead, bio.leadFrom);

const featured = (await getCollection('projects', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Future-dated items (e.g. graduation) stay hidden until a build on/after
// their date — never announce something that hasn't happened yet.
const news = (await getCollection('news'))
  .filter((item) => item.data.date.valueOf() <= Date.now())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

// Bocconi is a completed degree (alumniOf); TUM is where he studies from
// October 2026 — represented as affiliation only once the programme starts,
// so the markup never implies a degree he does not yet hold.
const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Leonardo Vanni',
  url: 'https://leonardovanni.com',
  jobTitle: byTumStart(
    'Incoming M.Sc. student, Technical University of Munich',
    'M.Sc. student, Technical University of Munich',
  ),
  description:
    'Computer vision researcher working on geometry-grounded 3D and 4D reconstruction and uncertainty estimation.',
  sameAs: [
    'https://github.com/VanniLeonardo',
    'https://www.linkedin.com/in/leonardo-vanni/',
    'https://orcid.org/0009-0003-1869-9286',
    'https://scholar.google.com/citations?user=xXGobYsAAAAJ&hl=en',
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Bocconi University',
    url: 'https://www.unibocconi.it',
  },
  ...(byTumStart(false, true) && {
    affiliation: {
      '@type': 'CollegeOrUniversity',
      name: 'Technical University of Munich',
      url: 'https://www.tum.de/en/',
    },
  }),
  email: 'mailto:info@leonardovanni.com',
});
---

<Base
  title="Leonardo Vanni — 3D/4D Computer Vision"
  description="Leonardo Vanni — researcher in geometry-aware 3D/4D computer vision: topology-aware 4D Gaussian Splatting for egocentric video, SE(3)-consistent uncertainty for 3D foundation models, real-time vision systems."
>
  <script type="application/ld+json" is:inline slot="head" set:html={personJsonLd} />

  {/* Hero */}
  <section class="grid grid-cols-1 gap-10 md:grid-cols-[1fr_230px] md:gap-16">
    <div class="order-1">
      <h1 class="font-heading text-[2rem] font-semibold tracking-tight sm:text-4xl">
        {hero.name}
      </h1>
      <p class="kicker mt-3">{status}</p>

      <p
        class="mt-7 max-w-[24ch] font-heading text-[1.6rem] leading-[1.25] font-medium text-balance sm:text-[1.9rem]"
      >
        {hero.statement}
      </p>

      <div class="prose mt-5 text-[0.95rem] text-muted">
        <HeroCurrently />
      </div>

      {/* Research CV leads, one-page CV follows, the rest stay quiet. */}
      <ul class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        {
          heroLinks.map((link) => (
            <li>
              <a
                href={link.url}
                class:list={[
                  link.weight === 'primary' &&
                    'inline-block bg-accent px-4 py-2 font-medium text-bg hover:bg-text',
                  link.weight === 'secondary' &&
                    'inline-block border border-border px-4 py-2 font-medium text-text hover:border-accent hover:text-accent',
                  !link.weight &&
                    'font-mono text-[0.8rem] text-muted underline decoration-rule underline-offset-3 hover:text-accent hover:decoration-accent',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      {hero.seeking && <p class="mt-5 text-sm text-muted">{hero.seeking}</p>}
    </div>
    <div class="order-2 mx-auto mt-2 w-44 sm:w-52 md:order-2 md:mx-0 md:w-full">
      <PhotoPlaceholder />
    </div>
  </section>

  {/* Selected research */}
  <section class="mt-20">
    <h2 class="kicker">Selected work</h2>
    <div class="mt-5 grid gap-10">
      {featured.map((project) => <ResearchRow project={project} />)}
    </div>
    <p class="mt-8 text-sm">
      <a
        href="/research/"
        class="font-mono text-[0.8rem] text-accent underline decoration-accent/40 underline-offset-3 hover:text-text hover:decoration-text"
        >Full research page →</a
      >
    </p>
  </section>

  {/* Background */}
  <section class="mt-20 border-t border-border pt-8">
    <h2 class="kicker">Background</h2>
    <ul class="mt-5 grid gap-5">
      {
        education.map((entry) => (
          <li class="max-w-[68ch]">
            <p class="kicker flex flex-wrap items-baseline gap-x-2">
              <span>{entry.period}</span>
            </p>
            <p class="mt-1 font-heading text-base font-semibold">
              {entry.url ? (
                <a href={entry.url} class="hover:text-accent">
                  {entry.institution}
                </a>
              ) : (
                entry.institution
              )}
            </p>
            <p class="mt-0.5 text-[0.95rem] text-muted">
              {entry.qualification} — {entry.note}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Selected experience */}
  <section class="mt-20 border-t border-border pt-8">
    <h2 class="kicker">Selected experience</h2>
    <div class="mt-5 grid gap-5">
      {roles.map((role) => <ExperienceEntry {...role} compact />)}
    </div>
    <p class="mt-8 text-sm">
      <a
        href="/experience/"
        class="font-mono text-[0.8rem] text-accent underline decoration-accent/40 underline-offset-3 hover:text-text hover:decoration-text"
        >Full experience page →</a
      >
    </p>
  </section>

  {/* Short bio */}
  <section class="mt-20 border-t border-border pt-8">
    <h2 class="kicker">About</h2>
    <div class="prose mt-4">
      <p>{bioLead}</p>
      <Bio />
    </div>
  </section>

  {/* News */}
  <section class="mt-20 border-t border-border pt-8">
    <h2 class="kicker">News</h2>
    <ul class="mt-5 grid gap-3">
      {news.map((item) => <NewsItem date={item.data.date} text={item.data.text} />)}
    </ul>
  </section>
</Base>
