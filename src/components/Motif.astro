---
// Research motifs, generated from real 3D geometry: a mesh is built, projected
// through a real camera, hidden surfaces removed, and the result emitted as
// hairline SVG. Regenerate with `npm run motifs` (scripts/motifs/).
//
// The SVGs use the site's CSS variables, so they follow the palette and cost
// nothing at runtime: no WebGL, no client JavaScript, no new dependency.
//
//   cut         Current research. A tuber, the blade entering, then the two
//               halves apart with the fresh cut surfaces picked out.
//   covariance  Thesis. One object seen from several cameras, with a real
//               uncertainty ellipsoid on the least constrained view.
//   grasp       Prosthetic arm. A bottle, its detected 3D box, and a
//               two-finger gripper closing in.
import cut from './motifs/cut.svg?raw';
import covariance from './motifs/covariance.svg?raw';
import grasp from './motifs/grasp.svg?raw';

interface Props {
  kind: 'cut' | 'covariance' | 'grasp';
}

const { kind } = Astro.props;
const motifs = { cut, covariance, grasp };
---

<Fragment set:html={motifs[kind]} />
