---
// /notes/ still builds but stays out of the nav until a note exists —
// never advertise an empty section.
const links = [
  { href: '/research/', label: 'Research' },
  { href: '/experience/', label: 'Experience' },
  { href: '/cv/', label: 'CV' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const isActive = (href: string) => path === href || path.startsWith(href);
---

{/* Mobile menu is a native <details> disclosure — keyboard operable and
    correctly announced as expanded/collapsed, with no JavaScript. Above md
    the summary is hidden and the list is always shown. */}
<header class="border-b border-border">
  <div
    class="mx-auto flex max-w-[62rem] flex-wrap items-baseline justify-between gap-x-6 px-5 py-5 sm:px-8"
  >
    <a href="/" class="font-heading text-lg font-semibold tracking-tight text-text hover:text-accent"
      >Leonardo Vanni</a
    >

    <details class="group w-full md:w-auto">
      <summary
        class="inline-block cursor-pointer list-none border border-border px-3 py-1 font-mono text-[11px] tracking-[0.14em] text-muted uppercase group-open:border-accent hover:border-accent md:hidden [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>

      <nav aria-label="Main navigation" class="hidden w-full group-open:block md:block md:w-auto">
        <ul class="flex flex-col gap-1 pt-3 md:flex-row md:gap-x-6 md:pt-0">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    'block py-1 font-mono text-[0.8rem] tracking-wide md:py-0',
                    isActive(link.href)
                      ? 'text-accent underline decoration-accent/50 underline-offset-4'
                      : 'text-muted hover:text-accent',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Above the mobile breakpoint this is not a disclosure at all: the nav is
     always visible, whether or not the <details> happens to be open. The
     display rule alone is not enough, because a closed <details> skips its
     content from layout entirely. */
  @media (min-width: 48rem) {
    details::details-content {
      content-visibility: visible;
      contain-intrinsic-size: auto none;
    }
  }
</style>
