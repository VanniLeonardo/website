---
// Experience entry: role · organization · period, with optional evidence
// bullets and links. The compact form (homepage) drops the bullets and links
// and keeps only the heading line.

interface Link {
  label: string;
  url: string;
}

interface Props {
  role: string;
  organization: string;
  period: string;
  bullets?: string[];
  links?: Link[];
  compact?: boolean;
  // h2 on /experience/, where entries sit directly under the page h1; h3 on
  // the homepage, where they sit under the section heading.
  as?: 'h2' | 'h3';
}

const {
  role,
  organization,
  period,
  bullets = [],
  links = [],
  compact = false,
  as: Heading = 'h3',
}: Props = Astro.props;
---

<article class="max-w-[68ch] border-t border-border pt-5">
  <p class="kicker flex flex-wrap items-baseline gap-x-2">
    <span>{organization}</span>
    <span aria-hidden="true">·</span>
    <span>{period}</span>
  </p>
  <Heading class="mt-1.5 font-heading text-lg font-semibold">{role}</Heading>

  {
    !compact && bullets.length > 0 && (
      <ul class="mt-3 grid gap-2">
        {bullets.map((bullet) => (
          <li class="relative pl-6 text-[0.95rem] leading-relaxed text-muted">
            <span class="absolute left-0 text-rule" aria-hidden="true">
              —
            </span>
            {bullet}
          </li>
        ))}
      </ul>
    )
  }

  {
    !compact && links.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
        {links.map((link) => (
          <li>
            <a
              href={link.url}
              class="font-mono text-[0.8rem] text-accent underline decoration-accent/40 underline-offset-3 hover:text-text hover:decoration-text"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
